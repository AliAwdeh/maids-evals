# Required for stable logins across restarts. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional. Fernet key for encrypting per-user LLM API keys at rest.
# If unset, a key is derived from SESSION_SECRET. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_FERNET=

# Stable site admin. Auth reads these on every boot; no manage_users.py step.
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Do not commit the real token. Put it in .env only.
ADMIN_USERNAME=admin
ADMIN_TOKEN=

# Optional. Default is 64.
MAX_REQUEST_WORKERS_CAP=64

# Optional provider endpoints (defaults match the current Maids setup).
OLLAMA_API_BASE=https://ai.aliawdeh.com/api
LANGCC_API_BASE=https://langcc.maidstech.ai/v1
